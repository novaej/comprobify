PORT=8080

# App environment — controls SRI endpoint routing
# staging    → always uses SRI test endpoint regardless of per-issuer sandbox flag
# production → uses SRI production endpoint for issuers with sandbox=false
APP_ENV=staging

# Public base URL of this API — required; used in verification email links when no
# per-tenant verificationRedirectUrl is set (e.g. https://api.yourdomain.com)
APP_BASE_URL=https://api.yourdomain.com

# Public docs base URL — used as prefix for RFC 7807 error type URIs
# When unset, error type URIs fall back to relative paths (/problems/...)
DOCS_BASE_URL=https://novaej.github.io/comprobify

# Verification token TTL in hours (default: 24)
# VERIFICATION_TOKEN_TTL_HOURS=24

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=comprobify_local
DB_USER=comprobify_app
DB_PASSWORD=
DB_SSL=false
# Required only for providers with a private CA (e.g. DigitalOcean managed
# Postgres) — download the cert from the provider's dashboard, then replace
# every real newline in the PEM with a literal \n so it fits on one line
# (a raw multi-line value breaks the deployed .env file — see
# docs/deployment.md). src/config/index.js converts it back to real
# newlines at runtime. Leave unset for providers with a publicly-trusted
# chain (e.g. Neon), or DB_SSL=false locally.
# Example: DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----
DB_SSL_CA=
# Max pg.Pool connections for THIS process. The API and worker are separate
# processes with separate pools, so tune each independently to fit your
# provider's total backend-connection ceiling — and remember any OTHER
# database sharing the same cluster (e.g. a frontend's DB) eats into that
# same ceiling too. deploy/docker-compose.yml sets 6 for api, 3 for worker,
# leaving headroom for comprobify-web's database on the staging cluster.
DB_POOL_MAX=5

# Encryption key for certificate passwords stored in the database (32-byte hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# SRI SOAP endpoints (override defaults if needed)
# SRI_TEST_BASE_URL=https://celcer.sri.gob.ec/comprobantes-electronicos-ws
# SRI_PROD_BASE_URL=https://cel.sri.gob.ec/comprobantes-electronicos-ws

# RabbitMQ — required. The document send/authorize pipeline is fully async
# (NEXT_STEPS.md item 2): POST /:key/send and GET /:key/authorize always
# queue and return 202; workers/sri-worker.js is the only process that calls
# SRI. Connection string from your broker (e.g. CloudAMQP), scoped to a
# dedicated vhost per environment.
RABBITMQ_URL=amqps://user:password@host/vhost
# RABBITMQ_SRI_EXCHANGE=sri.direct

# Queue reconciliation thresholds (all optional, minutes, defaults shown) —
# see queue-reconciliation.service.js / POST /v1/admin/jobs/queue-reconciliation
# QUEUE_RECONCILE_SEND_STALE_MINUTES=5
# QUEUE_RECONCILE_AUTHORIZE_DELAY_MINUTES=5
# QUEUE_RECONCILE_AUTHORIZE_STALE_MINUTES=5
# QUEUE_RECONCILE_BATCH_LIMIT=100

# Email delivery
EMAIL_PROVIDER=mailgun
# Bare email address only (no display name here — it is set in code):
#   Invoice/document emails: "{Issuer Business Name} via Comprobify <EMAIL_FROM_DOCUMENTS or EMAIL_FROM>"
#   All other transactional emails: "Comprobify <EMAIL_FROM>"
EMAIL_FROM=
# Optional — a separate From address for invoice/document emails only (e.g.
# facturas@yourdomain.com vs notificaciones@yourdomain.com). Falls back to
# EMAIL_FROM when unset.
EMAIL_FROM_DOCUMENTS=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.yourdomain.com
# From Mailgun dashboard → Sending → Webhooks → Webhook signing key
MAILGUN_WEBHOOK_SIGNING_KEY=

# Admin API — required, protects /admin/* endpoints
# Must be a 64-char hex string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Rate Limiting — per-API-key request limits
# RATE_LIMIT_WINDOW_MS: Time window in milliseconds, shared by write and read
# endpoints (default: 60000 = 1 minute). The request-count ceiling itself is
# NOT env-configurable — it comes from the tenant's subscription tier
# (TIERS[tier].writeRateLimit/.readRateLimit in src/constants/subscription-tiers.js),
# e.g. FREE: 10 write / 60 read requests per window.
# RATE_LIMIT_WINDOW_MS=60000

# Redis — optional. Backs the rate limiters' shared store (src/services/redis.service.js)
# so every API instance enforces one counter per key instead of each instance counting
# independently. Unset means the limiters fall back to express-rate-limit's own in-memory
# store, correct only for a single API instance. Self-hosted via deploy/docker-compose.yml's
# redis service — internal connection, no auth/TLS needed.
# REDIS_URL=redis://redis:6379

# Repeated-attempt detection (src/services/attempt-tracker.service.js) — also depends on
# REDIS_URL above; a no-op without it. ATTEMPT_TRACKER_THRESHOLD/_WINDOW_MS share one
# threshold/window across all event types (default: 5 within 15 minutes).
# ATTEMPT_TRACKER_THRESHOLD=5
# ATTEMPT_TRACKER_WINDOW_MS=900000

# Structured request logging (src/services/logger.service.js) — optional. Unset means
# logs still print locally as JSON (Console transport) but never ship anywhere. Source
# token from your Betterstack (Logs) project settings.
# BETTERSTACK_SOURCE_TOKEN=

# Sentry error monitoring — DSN from your Sentry project settings. Leave blank to disable.
SENTRY_DSN=

# Bank transfer instructions — returned in the subscription-creation response so a
# tenant knows where to send the SPI transfer for a paid plan. Display text, not a
# secret. REQUIRED — validated at startup (src/config/validate.js). Without these,
# a tenant creating a subscription gets an empty bank-transfer block with no way
# to actually pay.
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_TYPE=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_IDENTIFICATION=

# Operator inbox notified when a tenant uploads payment proof needing review.
# REQUIRED — validated at startup. Without it, proof submissions raise zero
# notification to anyone, discoverable only by manually polling the admin
# payments list.
ADMIN_NOTIFICATION_EMAIL=

# Ecuador's current IVA (VAT) rate, applied to subscription pricing. Defaults to
# 0.15 (15%, the rate in effect as of this writing) if left unset — override here
# if the rate changes (e.g. IVA_RATE=0.05 for 5%). A rate change should only
# ever need a config update + restart, never a code change.
# IVA_RATE=0.15

# Minimum notice (in days) a published tier price change must give before it
# takes effect, per docs/agreements/terms-of-service.md's price-change clause
# ("at least 30 days"). Defaults to 30 if left unset; POST /v1/admin/prices/:id/publish
# rejects an explicit noticeDays below this floor.
# PRICE_CHANGE_MIN_NOTICE_DAYS=30

# Operator identity — substituted into docs/agreements/*.md templates when publishing
# legal documents via POST /v1/admin/agreements. Tokens available:
#   {{operador.nombre}}, {{operador.ruc}}, {{operador.email}}, {{operador.domicilio}}
# OPERATOR_ADDRESS defaults to "Domicilio disponible previa solicitud razonable"
# if left blank — use the actual address if you want it visible in the documents.
OPERATOR_NAME=Your Business Name S.A.
OPERATOR_RUC=1234567890001
OPERATOR_EMAIL=legal@yourdomain.com
OPERATOR_ADDRESS=Your Street Address, City, Ecuador
