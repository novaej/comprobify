# Without trusted_proxies, Caddy discards Cloudflare's inbound X-Forwarded-For and
# substitutes its own peer IP instead. Ranges from https://www.cloudflare.com/ips-v4
# (same source as terraform/modules/droplet/main.tf's firewall allowlist).
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
    }
}

# Staging only for now. When production is provisioned, this needs to become either a
# second file (Caddyfile.production, picked by the production deploy workflow) or a
# {$PUBLIC_DOMAIN} env-substituted single file — revisit before the first production deploy.
api-staging.comprobify.com {
    reverse_proxy api:8080
}
